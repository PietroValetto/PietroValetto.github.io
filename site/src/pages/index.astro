---
import Base from "../layouts/Base.astro";
import { SITE } from "../site";
import Socials from "../components/Socials.astro";
import { Content as Bio } from "../content/home.md";

const l = SITE.links;
const links = [
  ["CV (PDF)", "/cv.pdf"], ["Email", `mailto:${SITE.email}`], ["Google Scholar", l.scholar], ["ORCID", l.orcid],
  ["University page", l.uantwerp], ["GitHub", l.github],
].filter(([, u]) => u);
---
<Base>
  <div class="intro">
    <img class="portrait" src="/portrait.jpg" alt="Portrait of Pietro Valetto" width="320" height="320" />
    <div>
      <h1>{SITE.name}</h1>
      <p class="subtitle">{SITE.role}<br />{SITE.affiliation}</p>
    </div>
  </div>
  <div class="bio"><Bio /></div>
  <ul class="links">{links.map(([label, url]) => <li><a href={url}>{label}</a></li>)}</ul>
  <div class="follow"><span class="follow-label">Follow along</span><Socials /></div>

  <h2>Projects</h2>
  <div class="card project">
    <div>
      <h3><a href="/tracker/">EU Iran-War Fuel Cost Tracker</a></h3>
      <p class="blurb">How much more Europeans have paid for petrol and diesel since the war began, for every member state. Updated weekly.</p>
    </div>
    <a class="btn btn-ghost" href="/tracker/">Open tracker</a>
  </div>
  <div class="card project">
    <div>
      <h3><a href="/popular-economics/">Popular Economics</a></h3>
      <p class="blurb">A newsletter and video series on the economic forces behind everyday life.</p>
    </div>
    <a class="btn btn-ghost" href={SITE.pe.substack}>Read on Substack</a>
  </div>
</Base>

<style>
  .follow { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 18px; }
  .follow-label { color: var(--slate); font-size: 14.5px; }
  .intro { display: flex; align-items: center; gap: 28px; margin-bottom: 28px; }
  .intro .subtitle { margin: 0; }
  .portrait { width: 152px; height: 152px; border-radius: 50%; object-fit: cover; flex: none; background: var(--green); }
  @media (max-width: 560px) { .intro { flex-direction: column; align-items: flex-start; gap: 18px; } .portrait { width: 128px; height: 128px; } }
  .bio :global(p) { margin-bottom: 14px; }
  .project { display: flex; gap: 16px 24px; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .project h3 a { color: var(--ink); text-decoration: none; }
  .project h3 a:hover { color: var(--link); text-decoration: underline; }
  .project .blurb { margin-top: 4px; color: var(--slate); }
  .project .btn { white-space: nowrap; }
  @media (max-width: 560px) { .project { flex-direction: column; align-items: flex-start; } }
</style>
